# ─────────────────────────────────────────────────────────────────────────────
# CereBroiler — Docker Compose environment
# Copy to .env and replace every CHANGE_ME value before starting the stack.
#   Generate secrets with:  python -c "import secrets; print(secrets.token_hex(24))"
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (shared instance, two databases) ──────────────────────────────
POSTGRES_USER=cerebroil
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
# Host port for psql / GUI clients. Change if 5432 is already in use.
POSTGRES_PORT=5432

# ── Fastify API (port 4000) ──────────────────────────────────────────────────
# Must be at least 32 characters.
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# "false" for plain HTTP (LAN demo). Switch to "true" behind TLS.
COOKIE_SECURE=false
API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Default admin created by the api-admin-seed one-shot.
ADMIN_EMAIL=admin@cerebroiler.dev
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# The sign-in page advertises "admin / admin", but the API only honours that
# shortcut under NODE_ENV=development. "true" re-enables it for a demo; keep
# it "false" wherever real users sign in.
DEMO_LOGIN_ENABLED=false

# ── Vision service (shared secret with the API) ──────────────────────────────
VISION_SERVICE_TOKEN=CHANGE_ME_VISION_TOKEN

# The flock's own clock, used by the night rule (birds asleep are not flagged).
# Containers run in UTC, so leaving this wrong shifts day and night by hours.
FARM_TZ=Asia/Manila

# ── Broiler behaviour detection (CAM-01) ─────────────────────────────────────
# Minutes between automatic readings. 0 stops the sampler.
BEHAVIOR_INTERVAL_MINUTES=5
# Gap between the two frames compared to measure movement.
VISION_FRAME_DELTA_MS=700

# The detector only starts once a model exists; until then the live feed and the
# feeder-zone editor still work and health reports model_loaded=false.
# Drop the file into gleam-screen-creator-main/packages/vision/models/.
# CHICKEN_CLASSES decides how the model's output columns are read:
#   one entry  -> the classes are the last columns, no separate objectness
#   two+       -> a separate objectness column is present (YOLOv5 layout)
CHICKEN_MODEL_PATH=/app/models/chicken.onnx
CHICKEN_INPUT_SIZE=640
CHICKEN_CLASSES=chicken
CHICKEN_CONF_MIN=0.35
CHICKEN_NMS_IOU=0.45
# "true" when the export already bakes NMS into the output rows.
CHICKEN_MODEL_HAS_NMS=false
# Where each box is tested against the feeder polygons: "centre" when the
# camera looks straight down, "foot" (bottom centre of the box) when it is
# angled, because that is where the bird is actually standing.
CHICKEN_ZONE_ANCHOR=centre

# ── Test clips (Settings → Test Clips) ──────────────────────────────────────
# A clip is measured by the same pipeline the camera feeds, and nothing it
# measures is ever written to the flock's history. Files live in the vision
# container's /tmp, so a restart forgetting them is the intended behaviour.
# Size ceiling for one upload, in MB.
VIDEO_MAX_MB=200
# Longest clip accepted, in seconds.
VIDEO_MAX_SECONDS=600
# Moments sampled by "Check the whole clip".
VIDEO_SWEEP_SAMPLES=30
# How long one sweep may spend measuring before it stops early.
VIDEO_SWEEP_BUDGET_S=90
# Minutes a clip stays on disk before it is dropped.
VIDEO_TTL_MINUTES=120
# Which camera's saved feeder zones a clip is judged against.
VIDEO_ZONE_CAMERA=CAM-01

# ── FastAPI telemetry backend (port 8000) ────────────────────────────────────
# Comma-separated keys accepted on POST /api/v1/telemetry/events.
BACKEND_API_KEYS=CHANGE_ME_BACKEND_KEY

# ── Web dashboard (port 8080) ────────────────────────────────────────────────
# Browser-reachable API URL — baked into the build, so it must not use a
# docker-internal hostname.
VITE_API_URL=http://localhost:4000

# ── AI insights (optional — /intelligence shows an error box when empty) ─────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Report a problem / SUS questionnaire (optional) ──────────────────────────
# Responses default to packages/api/data, inside the api_data volume.
SUS_CSV_PATH=
REPORT_CSV_PATH=
# Set both to also append responses to a Google Drive .csv via the Apps Script in
# packages/api/google-apps-script/sus-to-drive.gs.
SUS_GOOGLE_SCRIPT_URL=
SUS_GOOGLE_SCRIPT_TOKEN=

# ── Cameras ──────────────────────────────────────────────────────────────────
# The RTSP link is set in the dashboard (Settings > Camera) and stored in the
# database; both camera services read it from there within about ten seconds, so
# changing it needs no restart. The line below is only the fallback for an
# installation that has never saved one, and it is what "Clear" in Settings goes
# back to. Leave it empty to have no fallback.
DAHUA_RTSP_URL=rtsp://<user>:<camera-password>@192.168.1.108:554/cam/realmonitor?channel=1&subtype=1
KINECT_RTSP_URL=rtsp://localhost:8554/kinect_source
KINECT_SOURCE=simulated
# Host port the stream service is published on (docker-compose maps 5050:5000,
# and the web image is built to match). Change both together.
VITE_VISION_PORT=5050
# "camera_id=rtsp_url,..." is the pre-Settings way to name cameras for the vision
# service. The Settings link wins when one is saved; leave this empty.
RTSP_SOURCES=

# ── Alert thresholds ─────────────────────────────────────────────────────────
CLUSTER_DENSITY_THRESHOLD=0.75
INACTIVITY_SECONDS_THRESHOLD=300
LOG_LEVEL=info
