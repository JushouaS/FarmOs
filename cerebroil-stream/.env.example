# cerebroil-stream loads these from a local .env file (python-dotenv) if one
# exists next to app.py, falling back to the process environment otherwise --
# so a real .env here (gitignored) or exporting them in your shell/Docker/
# systemd unit both work.

# Must match packages/api's VISION_SERVICE_TOKEN exactly -- this is the
# shared secret packages/api sends as the X-Vision-Token header on every
# /health, /cameras, /stream, /capture, /analyze request. Leave it unset and
# every one of those routes refuses with 500 vision_token_not_configured.
VISION_SERVICE_TOKEN=change-me-to-match-packages-api

# Dahua overhead IR CCTV (RTSP). Normally set in the dashboard
# (Settings > Camera) and read from the database, with this line as the fallback
# for a machine that has never saved one. Falls back to RTSP_URL, then nothing.
DAHUA_RTSP_URL=rtsp://admin:<camera-password>@192.168.1.108:554/cam/realmonitor?channel=1&subtype=1

# Where that setting is read from: the same DATABASE_URL as packages/api/.env when this runs on the laptop. On a
# Raspberry Pi leave it out (the database is on the laptop), and the fallback above is used.
# DATABASE_URL=postgres://cerebroil:<password>@127.0.0.1:5434/farmos

# "simulated" (default), a device index ("0"), or an rtsp/http URL for the
# Kinect depth-to-weight station.
KINECT_SOURCE=simulated

# Detector model for "Test video" and live monitoring (not committed): an ONNX
# export of the trained YOLO model. Default: cerebroil-stream/models/detector.onnx
# DETECTOR_MODEL_PATH=
# The Analyze data scan on Live Camera counts birds with this model. 0 = motion only.
# SCAN_DETECTOR=1
# Boxes below this detector score are dropped.
# DETECTOR_CONFIDENCE=0.25
# The (hidden) Test video dialog checks this many seconds of a clip, at this many frames a second.
# DEMO_MAX_SECONDS=30
# DEMO_SAMPLE_FPS=4

# DHT22 temperature and humidity sensor (Raspberry Pi only, setup-dht22.sh): the GPIO number of its data pin, how
# often it is read, and the file the reading is kept in.
# DHT22_GPIO=4
# DHT22_INTERVAL=10
# DHT22_FILE=

# Daily CSV files, one folder per reading (logs/temperature/, logs/humidity/, logs/ammonia/, logs/behavior/):
# folder, days kept, seconds between rows.
# LOG_DIR=
# LOG_KEEP_DAYS=90
# LOG_SECONDS=60

# Ammonia sensor (ammonia.py). None is connected yet: leave it empty and the ammonia file says so every minute.
# AMMONIA_SENSOR=

# Daily one-hour recordings to .mkv on the SD card (recorder.py; setup-recorder.sh writes the first five).
# Day 1 at RECORD_FIRST_HOUR on RECORD_START_DATE, each next day RECORD_STEP_HOURS later, for RECORD_DAYS days.
# RECORD_START_DATE=2026-11-08
# RECORD_FIRST_HOUR=7
# RECORD_DAYS=8
# RECORD_STEP_HOURS=1
# RECORD_MINUTES=60
# RECORD_DIR=
# RECORD_RTSP_URL=
# RECORD_TIMEZONE=Asia/Manila

# Kinect weights saved on the Kinect computer (kinect_seg.py): logs/kinect-weights-YYYY-MM-DD.csv and
# logs/kinect-birds-YYYY-MM-DD.csv, one reading every this many seconds, watched or not. 0 turns saving off.
# KINECT_LOG_SECONDS=60

# Live monitoring: follow the birds on the live camera and report inactive or
# huddling birds to the API (which raises alerts). Needs the model above.
# It keeps the computer busy, so it is off until you set it to 1 (remove the #).
# LIVE_BEHAVIOR=1
# A frame every this many seconds.
# LIVE_SAMPLE_SECONDS=3
# How long a bird must stay still to count as inactive, and how long a huddle must last.
# LIVE_INACTIVE_SECONDS=1800
# LIVE_HUDDLE_SECONDS=600
# A bird has not moved in a picture when at least this share of the pixels in its box are the same as in the previous
# picture (Kim 2022: 95 %), and a pixel is the same when its grey value is within the tolerance (of 255).
# BEHAVIOR_STILL_PIXELS=0.95
# BEHAVIOR_PIXEL_TOLERANCE=20
# The tracker (ByteTrack) matches detections with at least this score first, then the weaker ones.
# BEHAVIOR_TRACK_HIGH=0.5
# A group of at least this many touching birds is a huddle (the thesis: three or more).
# BEHAVIOR_HUDDLE_MIN_BIRDS=3
