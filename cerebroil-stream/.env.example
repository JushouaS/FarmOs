# cerebroil-stream loads these from a local .env file (python-dotenv) if one
# exists next to app.py, falling back to the process environment otherwise --
# so a real .env here (gitignored) or exporting them in your shell/Docker/
# systemd unit both work.

# Must match packages/api's VISION_SERVICE_TOKEN exactly -- this is the
# shared secret packages/api sends as the X-Vision-Token header on every
# /health, /cameras, /stream, /capture, /analyze request. Leave it unset and
# every one of those routes refuses with 500 vision_token_not_configured.
VISION_SERVICE_TOKEN=change-me-to-match-packages-api

# Dahua overhead IR CCTV (RTSP). Normally set in the dashboard
# (Settings > Camera) and read from the database, with this line as the fallback
# for a machine that has never saved one. Falls back to RTSP_URL, then nothing.
DAHUA_RTSP_URL=rtsp://admin:<camera-password>@192.168.1.108:554/cam/realmonitor?channel=1&subtype=1

# Where that setting is read from. Without it the fallback above is used.
# DATABASE_URL=postgresql://cerebroil:<password>@localhost:5432/farmos

# "simulated" (default), a device index ("0"), or an rtsp/http URL for the
# Kinect depth-to-weight station.
KINECT_SOURCE=simulated

# Detector model for "Test video" and live monitoring (not committed): an ONNX
# export of the trained YOLO model. Default: cerebroil-stream/models/detector.onnx
# DETECTOR_MODEL_PATH=

# Live monitoring: follow the birds on the live camera and report inactive or
# huddling birds to the API (which raises alerts). Needs the model above.
# It keeps the computer busy, so it is off until you set it to 1.
# LIVE_BEHAVIOR=1
# A frame every this many seconds.
# LIVE_SAMPLE_SECONDS=3
# How long a bird must stay still to count as inactive, and how long a huddle must last.
# LIVE_INACTIVE_SECONDS=1800
# LIVE_HUDDLE_SECONDS=600
