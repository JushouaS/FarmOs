# The website's own settings. Copy this file to .env in the project folder (git ignores it).
# The database, login and camera settings are NOT here: they belong in packages/api/.env.

# -----------------------------------------------------------------------
# Insights page AI briefing: Groq (https://console.groq.com/keys)
# Free tier, no credit card. Optional: without it the Insights AI cards say the key is
# not configured and every other page works.
# -----------------------------------------------------------------------
GROQ_API_KEY=gsk_...

# Optional: override the chat model.
# Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# Camera service on another machine, for example a Raspberry Pi. Only used for the
# "Camera computer not answering" message; the video itself comes through the API.
# Leave it out for the camera service on this computer (port 5000). Restart `npm run dev` after changing it.
# VITE_VISION_ORIGIN=http://192.168.1.20:5000
