# -----------------------------------------------------------------------
# Intelligence engine — Groq (https://console.groq.com/keys)
# Free tier: no credit card required, ~30 req/min / 14,400 req/day.
# Required: the intelligence page will show a clear error if this is missing.
# -----------------------------------------------------------------------
GROQ_API_KEY=gsk_...

# Camera service on another machine, for example a Raspberry Pi. Leave it out
# to use the one on this computer (port 5000). Restart `npm run dev` after changing it.
# VITE_VISION_ORIGIN=http://192.168.1.20:5000

# Optional: override the chat model.
# Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
