# PostgreSQL. Copy this file to .env (which git ignores) and never commit the real values.
#
# Local database (the normal setup, HOW_TO_RUN.md section 3.4): `npm run db:local:init` reads this line and creates a
# private server with exactly this user, password, port and database name. You choose them: keep the user and the
# database name below, pick your own password (letters and digits are easiest; a symbol such as @ or # must be
# URL-encoded, @ = %40, # = %23), and keep port 5434 so it does not clash with an installed PostgreSQL on 5432.
DATABASE_URL=postgres://cerebroil:CHOOSE-A-PASSWORD@127.0.0.1:5434/farmos
# Only for a hosted database with separate pooler addresses (for example Supabase: its "Session" pooler as DATABASE_URL
# and its "Transaction" pooler here). Leave it out for the local database; it then uses DATABASE_URL.
# DATABASE_WRITE_URL=

# JWT — HS256 shared secret, strong random, at least 32 bytes.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# API server. API_HOST=0.0.0.0 makes it reachable from other devices on the network (a phone):
# only do that on a network you trust.
API_HOST=127.0.0.1
API_PORT=4000
API_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Which proxy in front of the API to believe about the client's address (X-Forwarded-For).
# Leave it as "false" unless the API sits behind a reverse proxy; then give that proxy's address
# (for example 10.0.0.5). Wrongly set, anyone can fake their address and dodge the limits.
# TRUST_PROXY=false

# Whether the sign-in cookies are Secure (HTTPS only). "auto" = yes in production. Over plain http
# a Secure cookie is never sent back, so use HTTPS in production and leave this on "auto".
# COOKIE_SECURE=auto

# Misc.
LOG_LEVEL=info
NODE_ENV=development

# Where the camera service runs. Default is this computer. For a Raspberry Pi
# use its address, for example http://192.168.1.20:5000.
# VISION_SERVICE_URL=http://127.0.0.1:5000

# Shared secret with the camera service: REQUIRED, and the same value goes into cerebroil-stream/.env (and the Pi's).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VISION_SERVICE_TOKEN=change-me-to-a-random-secret

# The camera's RTSP link, used only until someone saves one in Settings > Camera (the password never reaches the pages).
# DAHUA_RTSP_URL=rtsp://admin:<camera-password>@192.168.1.108:554/cam/realmonitor?channel=1&subtype=1

# The farm's time zone, for the day/night rule, the grow-out day and the daily export.
# FARM_TZ=Asia/Manila

# Minutes between automatic behaviour snapshots (the same check as "Analyze data"). 0 turns it off.
# BEHAVIOR_INTERVAL_MINUTES=5

# Where the Kinect bridge listens (this computer).
# KINECT_BRIDGE_URL=ws://127.0.0.1:8181/

# Where kinect_seg.py (the chicken outlines on the Kinect picture) runs. Default: this computer.
# KINECT_SEG_URL=http://127.0.0.1:8182

# Optional: needs the Kinect bridge to be started with the same value in its KINECT_BRIDGE_KEY
# (at least 16 characters). Then only signed-in viewers can open the 3D depth stream, and the bridge
# can be started with --lan. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# KINECT_BRIDGE_KEY=

# "Report a problem" and the SUS questionnaire are separate forms with separate
# files. They are always saved to packages/api/data/problem_reports.csv and
# packages/api/data/sus_responses.csv (override with REPORT_CSV_PATH and
# SUS_CSV_PATH). To ALSO save each one as a .csv of the same name in your
# Google Drive, deploy packages/api/google-apps-script/sus-to-drive.gs and set
# both values below (leave them empty to skip Google). The token is any long
# random string; the same value goes into the script's Script Properties as TOKEN.
SUS_CSV_PATH=
REPORT_CSV_PATH=
SUS_GOOGLE_SCRIPT_URL=
SUS_GOOGLE_SCRIPT_TOKEN=

# ---------------------------------------------------------------------------
# Alerts by email and browser push (src/notify.ts). People choose what they get
# in Settings > Notifications; these say whether the server CAN send. Leave them
# out and the Settings card says "not set up" for that channel.
# ---------------------------------------------------------------------------
# How long the temporary password an administrator hands out keeps working if the person has not
# signed in with it (hours, 1 to 336). The first sign-in must replace it with their own.
# TEMP_PASSWORD_HOURS=48

# Email: any SMTP account (a Gmail app password, your school's mail server, ...).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=
# SMTP_FROM=Cerebroil <you@example.com>
# Browser push: run `npm run vapid` in packages/api and paste the two keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Where people open the app (the link in an email).
# APP_URL=http://localhost:8080

# Live behavior monitor: asks the camera service every few seconds which birds are
# inactive or huddling and raises alerts. "off" turns it off.
# BEHAVIOR_MONITOR=on
# BEHAVIOR_POLL_SECONDS=30

# Live sensor monitor: asks the camera service every minute for the DHT22's temperature and humidity
# and stores them. "off" turns it off.
# SENSOR_MONITOR=on
# SENSOR_POLL_SECONDS=60
# A "Sensor Offline" alert after this many minutes without a reading from a sensor that used to report.
# SENSOR_OFFLINE_MINUTES=10
# Where /sensors is answered, when it is not the same machine as VISION_SERVICE_URL. Unset = VISION_SERVICE_URL.
# SENSOR_SOURCE_URL=http://PI-ADDRESS:5000

# Where Settings > Test clip uploads go: a computer running packages/vision (its /video routes; the Pi's camera service
# does not have them). Same VISION_SERVICE_TOKEN. Unset = VISION_SERVICE_URL.
# VIDEO_SERVICE_URL=http://127.0.0.1:5001
# Upload limits for a test clip (also set on the vision package).
# VIDEO_MAX_MB=2560
# VIDEO_MAX_SECONDS=3600

# Every this many minutes the API reads the Pi's daily sensor files and stores the readings that fall in a gap
# (for example while this computer was off). 0 turns it off.
# PI_BACKFILL_MINUTES=60

# Where `npm run export:daily` writes one folder per day (CSV files and a health summary). Point it at a folder that
# Google Drive or OneDrive syncs to get the files at home. Default: packages/api/exports.
# EXPORT_DIR=
