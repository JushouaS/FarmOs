# PostgreSQL (Supabase connection pool URL).
# Use the "Transaction" pooler for migrations and the "Session" pooler for the
# long-running API process. Never commit secrets; this file is gitignored.
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_WRITE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# JWT — HS256 shared secret, strong random, at least 32 bytes.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# API server.
API_HOST=127.0.0.1
API_PORT=4000
API_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Misc.
LOG_LEVEL=info
NODE_ENV=development
