{
  "name": "@farm-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/migrate.ts --up-to 0009_seed_from_dataset"
  },
  "dependencies": {
    "@farm-os/types": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/reply-from": "^12.6.4",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1",
    "jose": "^6.0.11",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
