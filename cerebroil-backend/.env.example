# ─────────────────────────────────────────────────────────────────────────────
# Cerebroil Backend — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Cerebroil API
APP_VERSION=1.0.0
DEBUG=false

# ── PostgreSQL (asyncpg DSN) ──────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://cerebroil:cerebroil_secret@db:5432/cerebroil

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for the telemetry ingest endpoint.
# Generate strong keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=change-me-key-1,change-me-key-2

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the web dashboard
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Alert thresholds ─────────────────────────────────────────────────────────
# Fraction of frame area (0.0 – 1.0) that triggers a clustering alert
CLUSTER_DENSITY_THRESHOLD=0.75
# Seconds of zero-detection before raising a low_activity alert
INACTIVITY_SECONDS_THRESHOLD=300
